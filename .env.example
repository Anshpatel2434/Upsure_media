# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Form emails (optional in dev) ----------------------------------------
# Resend API key. Form and newsletter submissions are emailed to EMAIL_TO.
# When empty, submissions are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Upsure Media website <hello@upsuremedia.com>"
EMAIL_TO=collab@upsuremedia.com

# --- Spam protection (optional in dev) -----------------------------------
# Cloudflare Turnstile. When empty, forms fall back to honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
