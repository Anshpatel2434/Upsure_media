# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Payload CMS) ---------------------------------------------
# Postgres connection string. Neon: use the pooled connection string and keep ?sslmode=require
# e.g. postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URI=

# --- Payload ------------------------------------------------------------
# Random 32+ character string used to sign auth tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# --- Media storage (optional in dev) -------------------------------------
# Leave S3_* empty to store uploads on local disk under ./media (dev default).
# Any S3-compatible bucket works in production (Cloudflare R2, AWS S3, MinIO).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for serving media when using S3 (e.g. https://media.upsuremedia.com)
S3_PUBLIC_URL=

# --- Email (optional in dev) --------------------------------------------
# Resend API key for form notifications. When empty, submissions are still stored in the admin.
RESEND_API_KEY=
EMAIL_FROM="Upsure <hello@upsuremedia.com>"
EMAIL_TO=upsureai@gmail.com

# --- Spam protection (optional in dev) -----------------------------------
# Cloudflare Turnstile. When empty, forms fall back to honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Preview / revalidation ---------------------------------------------
# Shared secret for the draft-preview and on-demand revalidation routes.
PREVIEW_SECRET=

# --- Seed (local only) ---------------------------------------------------
# `npm run seed` creates this admin user if no users exist yet.
SEED_ADMIN_EMAIL=admin@upsure.local
SEED_ADMIN_PASSWORD=change-me
