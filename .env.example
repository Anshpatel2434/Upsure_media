# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Form emails ---------------------------------------------------------
# Submissions are validated and spam-checked on the server, then delivered by
# ONE of these (Resend wins if both are set; with neither, dev prints to the
# console and production shows the form's "email us instead" error):
#
# Web3Forms access key (web3forms.com). Its free plan only accepts browser
# submissions, so the server hands the checked message back to the browser to
# post. Emails go to the address the key was created for.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Resend API key: emails EMAIL_TO from the server.
RESEND_API_KEY=
EMAIL_FROM="Upsure Media website <hello@upsuremedia.com>"
EMAIL_TO=upsureai@gmail.com

# --- Spam protection (optional in dev) -----------------------------------
# Cloudflare Turnstile, on every form (contact, call-back, brief, newsletter).
# Set BOTH keys together: a secret without a site key rejects every submission.
# When empty, forms fall back to honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (optional) -------------------------------------------------
# Header your host/proxy sets to the real visitor IP and clients cannot forge:
# cf-connecting-ip behind Cloudflare, x-real-ip on Vercel or nginx. When empty,
# the right-most X-Forwarded-For entry is used.
TRUSTED_IP_HEADER=
# Upstash Redis (free tier) shares the rate limit across server instances and
# restarts. When empty, each server process keeps its own in-memory count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
