{
  "name": "upsure-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upsure Media website — Next.js + Payload CMS",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && payload generate:types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx scripts/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/email-resend": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-form-builder": "^3.90.2",
    "@payloadcms/plugin-redirects": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "dotenv": "^18.0.4",
    "graphql": "^16.14.2",
    "next": "16.3.6",
    "payload": "^3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "graphql": "^16.8.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
